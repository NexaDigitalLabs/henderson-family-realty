# Copy to .env for local dev (`vercel dev`), or set these in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit the real .env — it is gitignored.

# ── Lead delivery (contact form) ─────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where leads are delivered. No setup needed on Resend's side to send TO an address.
LEAD_TO_EMAIL=adam@hfr.homes

# Who leads are sent FROM. MUST be on a Resend-VERIFIED domain.
# Resend verifies domains, not individual addresses — once a domain is verified,
# any address on it works. hfr.homes is NOT verified (adding a second domain
# costs $20/mo, deliberately deferred), so the code already defaults to
# nexadigitallabs.ai. You only need to set this to override that default.
# LEAD_FROM_EMAIL=Henderson Family Realty <website@nexadigitallabs.ai>

# ── Mortgage rates, Treasury, S&P 500 ────────────────────────────────────
# https://fredaccount.stlouisfed.org/apikeys  (free, instant)
FRED_API_KEY=

# ── Local market data ────────────────────────────────────────────────────
# https://app.rentcast.io/app/api  (free tier = 50 requests/MONTH)
# See the rate-limit note in api/market.js before touching CACHE_SECONDS.
RENTCAST_API_KEY=
